    "factsheet": [
        {
            "heading": "Open Studio and Keynote Panel Discussion",
            "paragraphs": [
                "Internationally renowned landscape architecture practice VOGT invites you to an Open Studio Day featuring a keynote address by Günther Vogt, founder of VOGT and recipient of the prestigious Sir Geoffrey Jellicoe Award.",
                "The keynote will be followed by a panel discussion with leading London-based urban thinkers exploring how we can design sustainable public spaces that endure for generations—not just the lifespan of the latest development cycle.",
                "Join us at our London studio for this special event, followed by refreshments and an opportunity to learn more about our work, meet the team, and discover nearby built projects."
            ]
        }
