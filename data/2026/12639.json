    "factsheet": [
        {
            "heading": "History",
            "paragraphs": [
                "A house built in 1864 and renovated in 1984, then 1993 and finally in 2023.",
                "The house is very unusual and is an example of how to adapt a Victorian house to modern living. Extensive work was carried out in 1984 ahead of the curve. The house has been used for many films and adverts due to its unique architectural design including films and TV dramas."
            ]
        }
