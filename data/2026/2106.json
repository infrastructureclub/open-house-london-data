    "factsheet": [
        {
            "heading": "Pergola Walking Tour",
            "paragraphs": [
                "Discover one of Hampstead Heath's hidden gems on a guided walk through the magnificent Hill Garden and Pergola.",
                "Learn about the fascinating history of this unique Edwardian structure, its connection to Lord Leverhulme, and how it has been transformed from a grand garden retreat into one of London's most treasured heritage sites.",
                "Tom, who leads the walk, is a long time Hampstead resident with a deep interest in architectural history and tour guiding. He works in the electricity industry but has been a volunteer visitor assistant at Sir John Soane's Museum in Holborn since 2016, and has also volunteered at Pitzhanger Manor, Sir John Soane's former country house in Ealing."
            ]
        },
        {
            "heading": "Meeting Point",
            "paragraphs": [
                "Please meet for the tour at White Stone Pond Flagpole"
            ]
        }
    ],
